# ══════════════════════════════════════════════
#  AgroSage — .gitignore
# ══════════════════════════════════════════════

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
*.whl

# ── Virtual Environments ──
venv/
env/
.venv/
.env

# ── IDE / Editor ──
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ── Jupyter ──
.ipynb_checkpoints/

# ── Trained Models (large binaries) — INCLUDE for deployment ──
!models/*.pkl
!models/*.h5
!models/.gitkeep

# ── Large training datasets — EXCLUDE (not needed at runtime) ──
data/Plant*Village*/
data/plant_disease_dataset*/
data/*.tflite
data/*.onnx
data/*.savedmodel/

# ── Dev tools / scripts ──
tools/

# ── Small runtime CSVs — INCLUDE ──
!data/Crop_recommendation.csv
!data/DailyDelhiClimate.csv
!data/weather_cache.json
!data/.gitkeep

# ── Logs & Temp ──
*.log
tmp/
.tmp/

# ── Streamlit ──
.streamlit/secrets.toml

# ── OS generated ──
*.DS_Store
ehthumbs.db
